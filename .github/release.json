{
  "version": {
    "scheme": "upstream-revision",
    "revision_path": "revision",
    "sources": [
      {
        "path": "version",
        "format": "text"
      }
    ],
    "locks": [
    ]
  },
  "publication": {
    "release_tag": "{version}{revision_suffix}",
    "github_release": true,

    "release_paths": ["version", "revision", "Dockerfile", ".github/release.json"],
    "latest_image": "extended",
    "images": [
      {
        "name": "extended",
        "repository": "mizucopo/comfyui-extended",
        "tag": "{version}{revision_suffix}",
        "aliases": ["latest"],
        "registry": "dockerhub"
      }
    ]
  }
}
